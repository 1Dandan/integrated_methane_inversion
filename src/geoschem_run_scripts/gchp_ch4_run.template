#!/bin/bash
##SBATCH -c 1

###############################################################################
### Sample GCHP run script for Harvard Cannon cluster (using SLURM).
###
### -n           : Requests this many cores (across all nodes)
### -N           : Requests this number of nodes
### -c 1         : Forces 1 task per CPU (needed after 2024/03/05 SLURM update)
### --mem        : Requests this amount of memory in GB
### -p           : Requests these partitions where the job can run
### -t           : Requests time for the job (days-hours:minutes)
### --exclusive  : Reserves entire nodes (i.e. to prevent backfilling jobs)
###############################################################################

# Exit if command fails
set -e

# Debug option to print all commands executed in this script
#set -x

# Keep only the newest log file; delete older logs for this run ID
function prune_logs() {
    ls -1t "${id}".*.log 2>/dev/null \
        | tail -n +2 \
        | xargs -r rm -f --
}

###############################################################################
# Recover an undated checkpoint left by the previous run
###############################################################################

function recover_undated_checkpoint() {
    local undated_checkpoint="./Restarts/gcchem_internal_checkpoint"
    local latest_log
    local normalized_tail
    local checkpoint_date
    local dated_checkpoint

    # No exact undated checkpoint exists. Nothing needs to be done.
    if [[ ! -f "$undated_checkpoint" ]]; then
        echo "No undated checkpoint found; recovery skipped."
        return 0
    fi

    echo "Found undated checkpoint from previous run:"
    echo "  $undated_checkpoint"

    # Find the latest previous log for this run ID.
    #
    # This function is called before the current run creates its new log,
    # so the newest matching log belongs to a previous run.
    latest_log=$(
        ls -1t "${id}".*.log 2>/dev/null |
            head -n 1
    )

    if [[ -z "$latest_log" || ! -f "$latest_log" ]]; then
        echo "WARNING: No previous ${id}.*.log file found." >&2
        echo "Removing unvalidated undated checkpoint." >&2
        rm -f -- "$undated_checkpoint"
        return 0
    fi

    echo "Checking final 30 lines of:"
    echo "  $latest_log"

    # Remove whitespace before checking the two completion messages.
    normalized_tail=$(
        tail -n 30 -- "$latest_log" |
            tr -d '[:space:]'
    )

    if [[ "$normalized_tail" != \
          *"UsingparallelNetCDFtowritefile:Restarts/gcchem_internal_checkpoint"* ||
          "$normalized_tail" != \
          *"NOTusingbufferI/Oforfile:cap_restart"* ]]; then

        echo "WARNING: Required checkpoint messages were not both found." >&2
        echo "Removing unvalidated undated checkpoint." >&2
        rm -f -- "$undated_checkpoint"
        return 0
    fi

    # Extract the latest GCHP date from the final 30 log lines.
    # Example:
    #
    #   GCHP Date: 2025/01/22
    #
    # becomes:
    #
    #   20250122
    checkpoint_date=$(
        tail -n 30 -- "$latest_log" |
            sed -nE \
                's|.*GCHP[[:space:]]+Date:[[:space:]]*([0-9]{4})/([0-9]{2})/([0-9]{2}).*|\1\2\3|p' |
            tail -n 1
    )

    if [[ ! "$checkpoint_date" =~ ^[0-9]{8}$ ]]; then
        echo "WARNING: Could not extract a valid GCHP date." >&2
        echo "Removing unvalidated undated checkpoint." >&2
        rm -f -- "$undated_checkpoint"
        return 0
    fi

    dated_checkpoint="./Restarts/gcchem_internal_checkpoint.${checkpoint_date}_0000z.nc4"

    # Do not overwrite an existing dated checkpoint.
    if [[ -e "$dated_checkpoint" ]]; then
        echo "WARNING: Dated checkpoint already exists:" >&2
        echo "  $dated_checkpoint" >&2
        echo "Removing redundant undated checkpoint." >&2
        rm -f -- "$undated_checkpoint"
        return 0
    fi

    echo "Recovering checkpoint from previous run:"
    echo "  $undated_checkpoint"
    echo "  -> $dated_checkpoint"

    if ! mv -- "$undated_checkpoint" "$dated_checkpoint"; then
        echo "ERROR: Failed to rename the undated checkpoint." >&2
        echo "The undated checkpoint has been retained." >&2
        return 1
    fi

    echo "Previous checkpoint recovered successfully."
}


###############################################################################
# Existing checkpoint functions
###############################################################################

function has_checkpoint() {
    compgen -G "./Restarts/gcchem_internal_checkpoint*.nc4" > /dev/null
}

function last_checkpoint() {
    ls -1 ./Restarts/gcchem_internal_checkpoint*.nc4 | tail -n 1
}

function last_checkpoint_datetime() {
    last_checkpoint | sed 's/\.\/Restarts\/gcchem_internal_checkpoint\.\([1-9][0-9][0-9][0-9][0-9][0-9][0123][0-9]\)_\([0-9][0-9]00\).*/\1 \200/'
}

# Keep only the most recent internal checkpoints; delete older ones
function prune_checkpoints() {
    local keep=1

    ls -1 ./Restarts/gcchem_internal_checkpoint*.nc4 2>/dev/null \
        | head -n -${keep} \
        | xargs -r rm -f
}


###############################################################################
# Output-file checking functions
###############################################################################
# Expected number of hourly records in each daily SpeciesConc file
EXPECTED_TIME_STEPS=24
OUTPUT_DIR="./OutputDir"

# Return the length of the unlimited time dimension
function get_time_length() {
    local file="$1"
    local time_len

    [[ -f "$file" && -s "$file" ]] || return 1

    time_len=$(
        ncdump -h "$file" 2>/dev/null |
        sed -nE \
            's/^[[:space:]]*time = UNLIMITED ;[[:space:]]*\/\/[[:space:]]*\(([0-9]+) currently\).*/\1/p' |
        head -n 1
    )

    [[ "$time_len" =~ ^[0-9]+$ ]] || return 1
    printf '%s\n' "$time_len"
}

# Remove all GEOS-Chem output collections belonging to one incomplete date
function remove_output_date() {
    local output_dir="$1"
    local file_date="$2"
    local file
    local found=0

    echo "Removing output files for incomplete date: ${file_date}"

    while IFS= read -r -d '' file; do
        found=1
        echo "  Removing: $file"

        if ! rm -f -- "$file"; then
            echo "ERROR: Failed to remove $file" >&2
            return 1
        fi
    done < <(
        find "$output_dir" \
            -maxdepth 1 \
            -type f \
            -name "GEOSChem.*.${file_date}_0000z.nc4" \
            -print0
    )

    if [[ "$found" -eq 0 ]]; then
        echo "  No matching files found."
    fi
}

# Find incomplete daily SpeciesConc files and remove every GEOS-Chem
# collection for those dates before MAPL reopens the output collections.
function remove_incomplete_output_dates() {
    local output_dir="$1"
    local species_file
    local filename
    local file_date
    local time_len
    local date_to_remove

    local -a species_files=()
    declare -A incomplete_dates=()

    # A new run may not have created OutputDir yet. This is not an error.
    if [[ ! -d "$output_dir" ]]; then
        echo "Output directory does not exist yet; nothing to clean: $output_dir"
        return 0
    fi

    # Collect matching daily SpeciesConc files first. An existing but empty
    # OutputDir, or one containing no SpeciesConc files, is also not an error.
    mapfile -d '' -t species_files < <(
        find "$output_dir" \
            -maxdepth 1 \
            -type f \
            -name 'GEOSChem.SpeciesConc.[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]_0000z.nc4' \
            -print0
    )

    if (( ${#species_files[@]} == 0 )); then
        echo "No existing daily SpeciesConc files in $output_dir; nothing to clean."
        return 0
    fi

    echo "Checking ${#species_files[@]} existing SpeciesConc file(s) for incomplete dates..."

    for species_file in "${species_files[@]}"; do
        filename=${species_file##*/}

        if [[ "$filename" =~ ^GEOSChem\.SpeciesConc\.([0-9]{8})_0000z\.nc4$ ]]; then
            file_date=${BASH_REMATCH[1]}
        else
            continue
        fi

        if ! time_len=$(get_time_length "$species_file"); then
            echo "Incomplete or unreadable file:"
            echo "  $species_file"
            incomplete_dates["$file_date"]=1
            continue
        fi

        if [[ "$time_len" -lt "$EXPECTED_TIME_STEPS" ]]; then
            echo "Incomplete file: ${time_len}/${EXPECTED_TIME_STEPS} records"
            echo "  $species_file"
            incomplete_dates["$file_date"]=1

        elif [[ "$time_len" -eq "$EXPECTED_TIME_STEPS" ]]; then
            echo "Complete file: ${file_date}, ${time_len}/${EXPECTED_TIME_STEPS} records"

        else
            echo "WARNING: File contains more than ${EXPECTED_TIME_STEPS} records:" >&2
            echo "  Records: $time_len" >&2
            echo "  File: $species_file" >&2
            echo "  It will not be deleted automatically." >&2
        fi
    done

    if (( ${#incomplete_dates[@]} == 0 )); then
        echo "No incomplete SpeciesConc dates found."
        return 0
    fi

    while IFS= read -r date_to_remove; do
        [[ -n "$date_to_remove" ]] || continue

        if ! remove_output_date "$output_dir" "$date_to_remove"; then
            return 1
        fi
    done < <(
        printf '%s\n' "${!incomplete_dates[@]}" | sort
    )

    echo "Incomplete-output cleanup completed."
}

###############################################################################
# Initialize run
###############################################################################

# Define version ID
id=namename

# Remove old logs, but retain the newest previous log for checkpoint recovery.
prune_logs

# Recover a useful undated checkpoint left by the previous run.
#
# This must happen before the current log file is created.
recover_undated_checkpoint

# Define GEOS-Chem log file
log="$id.$(date +"%Y%m%d_%H%M").log"

echo '===> Run started at' `date` >> $log

# Remove error status file if present
rm -f .error_status_file.txt
echo "Writing output to ${log}"


###############################################################################
# Configure GCHP
###############################################################################

# Cannon-specific setting to get around connection issues at high # cores
export OMPI_MCL_btl=openib

# Run GCHP and evenly distribute tasks across nodes
NX=$( grep NX GCHP.rc | awk '{print $2}' )
NY=$( grep NY GCHP.rc | awk '{print $2}' )
coreCount=$(( ${NX} * ${NY} ))
planeCount=$(( ${coreCount} / ${SLURM_NNODES} ))
if [[ $(( ${coreCount} % ${SLURM_NNODES} )) > 0 ]]; then
    planeCount=$(( ${planeCount} + 1 ))
fi


###############################################################################
# Configure restart
###############################################################################

# Get initial start date
START_DATE=$(awk '/^[[:space:]]*BEG_DATE:/ {$1=""; sub(/^[[:space:]]+/, ""); print}' CAP.rc)
if [[ "${START_DATE}" = "" ]]; then
    echo "ERROR: cap_restart is empty! Write your simulation start date 'YYYYMMDD 000000' to cap_restart." >> $log
fi
N=$(grep "CS_RES=" setCommonRunSettings.sh | cut -c 8- | xargs)
initial_restart=./Restarts/GEOSChem.Restart.${START_DATE:0:8}_0000z.c${N}.nc4
if [ ! -f $initial_restart ]; then
    echo "ERROR: inital restart file of ${initial_restart} does not exist! Set a soft link for your initial restart file." >> $log
fi

# Remove the initial checkpoint file if it exists
# as it will always be created at the start (when Checkpoint_Freq=HHMMSS)
# but cannot be overwritten and thus will cause a running error
initial_checkpoint=./Restarts/gcchem_internal_checkpoint.${START_DATE:0:8}_0000z.nc4
rm -f $initial_checkpoint

if has_checkpoint; then
    RESTART_FILE=$(last_checkpoint)
    RESTART_DATE=$(last_checkpoint_datetime)
    echo "$RESTART_DATE" > cap_restart
    # Prune old internal checkpoints, keeping the most recent as backup
    prune_checkpoints
    ln -nsf ${RESTART_FILE} gchp_restart.nc4
else
    echo "$START_DATE" > cap_restart
    # Run setCommonRunSettings.sh only at initial start date
    # as running it will update GCHP.rc to the new cap_restart and cause
    # conflicting writes to an existing checkpoint
    ./setCommonRunSettings.sh
    ln -nsf ${initial_restart} gchp_restart.nc4
fi
rm -f ./Restarts/gcchem_internal_checkpoint

###############################################################################
# Remove incomplete output
###############################################################################

# Remove incomplete output left by a cancelled or failed run. If the
# SpeciesConc file for a date has fewer than 24 records or is unreadable,
# remove all GEOSChem.* collections for that date so MAPL can recreate them.
if ! remove_incomplete_output_dates "$OUTPUT_DIR"; then
    echo "ERROR: Failed while removing incomplete output files." | tee -a "$log" >&2
    exit 1
fi

###############################################################################
# Run GCHP
###############################################################################

# Allow the script to continue after the intentionally cancelled srun step.
set +e

# This script has one srun command, so its Slurm step is .0.
# For an array task, this produces an ID such as 12240_4.0.
if [[ -n "${SLURM_ARRAY_JOB_ID:-}" &&
      -n "${SLURM_ARRAY_TASK_ID:-}" ]]; then
    gchp_step_id="${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}.0"
else
    gchp_step_id="${SLURM_JOB_ID}.0"
fi

srun_error_log="slurm-${gchp_step_id}.stderr"
rm -f -- "$srun_error_log"

# Run GCHP in the background so this shell can monitor the log.
srun \
    -n "${coreCount}" \
    -N "${SLURM_NNODES}" \
    -m "plane=${planeCount}" \
    --mpi=pmix \
    ./gchp >> "$log" 2>> "$srun_error_log" &

srun_pid=$!

echo "Started GCHP step: $gchp_step_id" >> "$log"

# Monitor the final log lines while GCHP is running.
while kill -0 "$srun_pid" 2>/dev/null; do
    sleep 2

    normalized_tail=$(
        tail -n 30 -- "$log" 2>/dev/null |
            tr -d '[:space:]'
    )

    if [[ "$normalized_tail" == \
          *"UsingparallelNetCDFtowritefile:Restarts/gcchem_internal_checkpoint"* &&
          "$normalized_tail" == \
          *"NOTusingbufferI/Oforfile:cap_restart"* &&
          -s "./Restarts/gcchem_internal_checkpoint" ]]; then

        {
            echo
            echo "Completed checkpoint detected."
            echo "Cancelling GCHP step: $gchp_step_id"
        } >> "$log"

        # Cancel only the srun/GCHP step, not the surrounding batch script.
        if scancel --signal=TERM "$gchp_step_id"; then
            break
        else
            echo "WARNING: Failed to cancel $gchp_step_id; retrying." \
                >> "$log"
        fi
    fi
done

# Wait until the cancelled srun step has fully exited.
# Its nonzero status is expected and intentionally ignored.
wait "$srun_pid" || true

echo "GCHP step has stopped; continuing to checkpoint renaming." >> "$log"

###############################################################################
# Rename final checkpoint
###############################################################################

# Rename final gcchem_internal_checkpoint if new start time is okay
new_start_str=$(cat cap_restart)
if [[ "${new_start_str:0:8}" = "${START_DATE:0:8}" || "${new_start_str}" = "" ]]; then
    echo "ERROR: GCHP failed to run to completion. Check the log file for more information." >> ${log}
    rm -f Restarts/gcchem_internal_checkpoint
    exit 1
else
    mv \
        Restarts/gcchem_internal_checkpoint \
        Restarts/gcchem_internal_checkpoint.${new_start_str:0:8}_0000z.nc4
fi

echo '===> Run ended at' `date` >> $log

exit 0